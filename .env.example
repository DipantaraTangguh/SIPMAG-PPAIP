APP_NAME=SIPMAG
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Wajib sama persis dengan origin yang dibuka peramban. Kalau berbeda,
# unggah berkas di panel Filament menggantung tanpa pesan galat dan sesi API
# ikut rusak. Port 8000 mengikuti compose.yaml.
APP_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,localhost:5173,127.0.0.1:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SECURITY_LOG_LEVEL=info
SECURITY_LOG_DAYS=90

# Nilainya mengikuti service mysql di compose.yaml, jadi berkas ini bisa
# disalin apa adanya untuk pengembangan lokal. DB_HOST memakai nama service
# "mysql", bukan 127.0.0.1, karena aplikasi berjalan di dalam jaringan Docker;
# port 3306 juga port di dalam jaringan itu, bukan 3307 yang dibuka ke host.
# Kredensial di bawah hanya berlaku untuk database pengembangan sekali pakai
# dan memang sudah tertulis di compose.yaml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sipmag
DB_USERNAME=admin
DB_PASSWORD=admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_TOKEN_EXPIRATION=480

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

AUTH_LOCK_AFTER_ATTEMPTS=5
AUTH_INITIAL_LOCK_SECONDS=60
AUTH_MAXIMUM_LOCK_SECONDS=900
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
