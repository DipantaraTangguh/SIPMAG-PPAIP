FROM php:8.4-fpm

# Install system dependencies.
#
# libreoffice-writer wajib: seluruh surat (Form 1 & Form 2) dibuat dengan
# merender template DOCX lewat `soffice --convert-to pdf`. Tanpa ini
# DocxToPdfRenderer mengembalikan null dan unduh surat gagal dengan 503.
# Dipakai varian -writer, bukan paket libreoffice penuh, supaya image ringan.
RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libicu-dev \
    libzip-dev \
    libreoffice-writer \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Configure GD
RUN docker-php-ext-configure gd \
    --with-freetype \
    --with-jpeg

# Install PHP extensions
RUN docker-php-ext-install \
    gd \
    intl \
    zip \
    pdo_mysql

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www

# Copy application
COPY . .

# Install Laravel dependencies
RUN composer install \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader

# Set permissions
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache

EXPOSE 9000

#CMD ["php-fpm"]
# public/storage di-gitignore dan environment-specific, jadi dibuat saat start.
# Tanpa ini clone baru + `docker compose up` bikin logo perusahaan 404.
#
# Dibuat pakai `ln` relatif, bukan `artisan storage:link`: direktori ini
# bind-mount, jadi symlink yang sama dibaca dari container (/var/www/...) dan
# dari host (/Users/...). Symlink absolut hanya benar di salah satunya.
# Opsi --relative milik artisan butuh paket symfony/filesystem yang tidak
# terpasang, dan tidak sepadan hanya demi satu symlink.
# -f -n aman diulang: symlink lama ditimpa, bukan ditembus.
CMD ["sh", "-c", "ln -sfn ../storage/app/public public/storage && php artisan serve --host=0.0.0.0 --port=8000"]